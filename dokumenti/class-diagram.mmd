---
title: CompetitionSolution - class diagram (up to Sprint 4)
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB

    %% ---------- Base ----------
    class BaseEntity {
        <<abstract>>
        +Guid Id
        +string PublicId
        +Instant CreatedAt
        +Instant ModifiedAt
        +Instant? DeletedAt
    }

    %% ---------- Identity / auth ----------
    class IdentityUser~Guid~ {
        <<ASP.NET Identity>>
    }
    class IdentityRole~Guid~ {
        <<ASP.NET Identity>>
    }
    class ApplicationUser {
        +string PublicId
        +Instant? RegisteredAt
        +string FirstName
        +string LastName
        +bool IsActive
    }
    class ApplicationRole
    class RefreshToken {
        +Guid Id
        +string Token
        +DateTime Expires
        +bool IsRevoked
        +DateTime? RevokedAt
        +Guid UserId
    }

    %% ---------- Geo (Sprints 1-3) ----------
    class Country {
        +string? Name
        +string? Slug
        +string? PictureUrl
    }
    class City {
        +string? Name
        +int Population
        +bool IsCapital
        +string? Slug
        +Guid CountryId
        +Guid GeoDataId
    }
    class GeoData {
        +decimal Latitude
        +decimal Longitude
        +string? Description
    }
    class Club {
        +string Name
        +string Slug
        +LocalDate? FoundingDate
        +ClubAge ClubAge
        +Guid? CityId
        +Guid? StadiumId
    }
    class ClubAge {
        <<enumeration>>
        U7
        U9
        U11
        U13
        U16
        U19
        U21
        Senior
    }
    class Stadium {
        +string? Name
        +int Capacity
        +DateTime DateOfConstruction
        +string? Slug
        +string? PictureUrl
        +Guid CityId
        +Guid GeoDataId
    }

    %% ---------- Match (Sprints 1-3) ----------
    class Match {
        +Instant Date
        +int FollowersCount
        +int? HomeScore
        +int? AwayScore
        +int? HalfHomeScore
        +int? HalfAwayScore
        +bool IsPostponed
        +string? Slug
        +Guid StatusId
        +Guid StadiumId
        +Guid? HomeSelectionId
        +Guid? AwaySelectionId
        +Guid? RoundId
    }
    class Event {
        Guid MatchId
        Guid EventTypeId
        Guid MatchPartId
        Guid SelectionId
        Guid? PlayerId
        Guid? RelatedPlayerId
        int Minute
        int AddedMinute
        string? Note
    }
    class EventType {
        string Code
        string Name
        int SortOrder
    }
    class MatchPart {
        string Code
        string Name
        int SortOrder
    }
    class MatchStatus {
        +string Name
        +string? Slug
    }

    %% ---------- Selection and people (Sprints 1-3) ----------
    class Selection {
        +string Name
        +string Abbreviation
        +string? PictureUrl
        +int FollowersCount
        +string? Slug
        +Guid CountryId
        +Guid? ClubId
    }
    class Person {
        +string FirstName
        +string LastName
        +LocalDate DateOfBirth
        +byte[] Picture
    }
    class Player {
        +decimal Height
        +int ShirtNumber
        +float TransferValue
        +Guid? PositionId
        +Guid? SubPositionId
    }
    class Manager {
        +LocalDate? CareerStart
    }
    class Referee {
        +LocalDate? CareerStart
    }
    class TransferValueHistory {
        +LocalDate? Date
        +decimal? Value
        +Guid PlayerId
    }
    class PlayerSelectionHistory {
        +int? Goals
        +int? MatchPlayed
        +int? Assists
        +int? ShirtNumber
        +Guid PlayerId
        +Guid? SelectionId
    }
    class SelectionManagerHistory {
        +string? Notes
        +int? Wins
        +int? Loses
        +int? Draw
        +Guid ManagerId
        +Guid? SelectionId
    }
    class MandatDate {
        +LocalDate? StartMandatDate
        +LocalDate? EndMandatDate
        +Guid? PlayerSelectionHistoryId
        +Guid? SelectionManagerHistoryId
    }

    %% ---------- Formation (Sprints 1-3) ----------
    class Formation {
        +string Code
        +string? Slug
        +Guid FormationMarkId
    }
    class FormationMark {
        +int Defenders
        +int Midfielders
        +int Attackers
        +string? Slug
    }
    class Position {
        +string Name
        +string? Slug
    }
    class SubPosition {
        +string Name
        +string? Slug
        +Guid PositionId
    }

    %% ---------- Competition (Sprint 4) ----------
    class Competition {
        +string Name
        +string Slug
        +string? ShortName
        +string? Description
        +Guid? CountryId
    }
    class Season {
        +string Name
        +string Slug
        +LocalDate StartDate
        +LocalDate EndDate
        +bool IsCurrent
        +Guid CompetitionId
    }
    class Round {
        +string Name
        +string Slug
        +int Number
        +Guid SeasonId
    }

    class Statistic {
        +Guid MatchId
    }
    class MatchReview {
        +Guid MatchId
        +Guid AuthorId
        +int Rating
        +string Comment
    }
    class ReviewReaction {
        +Guid ReviewId
        +Guid UserId
        +int Value
    }
    class TeamStatistic {
        +Guid StatisticId
        +Guid SelectionId
        +int TotalShots
        +int ShotsOnTarget
        +int TotalRedCards
        +int TotalYellowCards
        +int Corners
        +int BigChances
        +int Possession
    }

    %% ---------- Inheritance ----------
    IdentityUser~Guid~ <|-- ApplicationUser
    IdentityRole~Guid~ <|-- ApplicationRole
    BaseEntity <|-- Country
    BaseEntity <|-- City
    BaseEntity <|-- GeoData
    BaseEntity <|-- Stadium
    BaseEntity <|-- Club
    BaseEntity <|-- Match
    BaseEntity <|-- MatchStatus
    BaseEntity <|-- Event
    BaseEntity <|-- EventType
    BaseEntity <|-- MatchPart
    BaseEntity <|-- Statistic
    BaseEntity <|-- MatchReview
    BaseEntity <|-- ReviewReaction
    BaseEntity <|-- TeamStatistic
    BaseEntity <|-- Selection
    BaseEntity <|-- Person
    BaseEntity <|-- TransferValueHistory
    BaseEntity <|-- PlayerSelectionHistory
    BaseEntity <|-- SelectionManagerHistory
    BaseEntity <|-- MandatDate
    BaseEntity <|-- Formation
    BaseEntity <|-- FormationMark
    BaseEntity <|-- Position
    BaseEntity <|-- SubPosition
    BaseEntity <|-- Competition
    BaseEntity <|-- Season
    BaseEntity <|-- Round
    Person <|-- Player
    Person <|-- Manager
    Person <|-- Referee

    %% ---------- Associations ----------
    %% <--> = navigable from both classes (navigation property on each side), --> = only the FK side navigates.
    ApplicationUser "1" <--> "0..*" RefreshToken : RefreshTokens / User

    Country "1" <--> "0..*" City : Cities / Country
    City "0..*" --> "1" GeoData : GeoData
    Club "0..*" --> "0..1" City : City
    Club "0..*" --> "0..1" Stadium : Stadium
    Club --> ClubAge : age group
    Stadium "0..*" --> "1" City : City
    Stadium "0..*" --> "1" GeoData : GeoData

    Match "0..*" <--> "1" MatchStatus : Status / Matches
    Match "0..*" --> "1" Stadium : Stadium
    Match "1" <--> "0..*" Statistic : Statistics / Match
    Statistic "1" <--> "0..*" TeamStatistic : TeamStatistics / Statistic
    TeamStatistic "0..*" --> "1" Selection : Selection
    MatchReview "0..*" --> "1" Match : Match
    Event "0..*" --> "1" Match : Match
    Event "0..*" --> "1" EventType : EventType
    Event "0..*" --> "1" MatchPart : MatchPart
    Event "0..*" --> "1" Selection : Selection
    Event "0..*" --> "0..1" Player : Player off / event player
    Event "0..*" --> "0..1" Player : RelatedPlayer on
    MatchReview "0..*" --> "1" ApplicationUser : Author
    MatchReview "1" <--> "0..*" ReviewReaction : Reactions / Review
    ReviewReaction ..> ApplicationUser : UserId FK
    Match "0..*" <--> "0..1" Selection : HomeSelection / HomeMatches
    Match "0..*" <--> "0..1" Selection : AwaySelection / AwayMatches

    Selection "0..*" --> "1" Country : Country
    Selection "0..*" --> "0..1" Club : Club
    Player "0..*" <--> "0..1" Position : Position / Players
    Player "0..*" <--> "0..1" SubPosition : SubPosition / Players
    Position "1" <--> "0..*" SubPosition : SubPositions / Position
    Formation "1" <--> "1" FormationMark : FormationMark / Formation

    TransferValueHistory "0..*" --> "1" Player : Player
    PlayerSelectionHistory "0..*" --> "1" Player : Player
    PlayerSelectionHistory "0..*" <--> "0..1" Selection : Selection / PlayerHistories
    SelectionManagerHistory "0..*" --> "1" Manager : Manager
    SelectionManagerHistory "0..*" <--> "0..1" Selection : Selection / ManagerHistories
    MandatDate "0..*" --> "0..1" PlayerSelectionHistory : PlayerSelectionHistory
    MandatDate "0..*" --> "0..1" SelectionManagerHistory : SelectionManagerHistory

    Competition "0..*" --> "0..1" Country : Country
    Competition "1" <--> "0..*" Season : Seasons / Competition
    Season "1" <--> "0..*" Round : Rounds / Season
    Match "0..*" <--> "0..1" Round : Round / Matches

    %% ---------- Legend (colour swatches) ----------
    class LegendSprint1to3["Legend: Sprints 1-3"] {
        <<legend>>
    }
    class LegendSprint4["Legend: new in Sprint 4"] {
        <<legend>>
    }
    class LegendIdentity["Legend: ASP.NET Identity"] {
        <<legend>>
    }
    LegendSprint1to3 .. LegendSprint4
    LegendSprint4 .. LegendIdentity

    %% ---------- Notes ----------
    note for BaseEntity "All domain classes inherit BaseEntity (soft delete via DeletedAt). ApplicationUser, ApplicationRole and RefreshToken do not."
    note for LegendSprint4 "Sprint 4 also added Match.RoundId (Match -> Round).
COMP-41 added Event, EventType and MatchPart. Selection.HomeStadiumId remains planned under COMP-75."

    %% ---------- Colours ----------

