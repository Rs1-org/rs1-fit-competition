---
title: CompetitionSolution - class diagram (up to Sprint 6)
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB

    %% ---------- Base ----------
    class BaseEntity {
        <<abstract>>
        +Guid Id
        +string PublicId
        +Instant CreatedAt
        +Instant ModifiedAt
        +Instant? DeletedAt
    }

    %% ---------- Identity / auth ----------
    class IdentityUser~Guid~ {
        <<ASP.NET Identity>>
    }
    class IdentityRole~Guid~ {
        <<ASP.NET Identity>>
    }
    class ApplicationUser {
        +string PublicId
        +Instant? RegisteredAt
        +string FirstName
        +string LastName
        +bool IsActive
        +Instant? PremiumUntil
    }
    class ApplicationRole
    class RefreshToken {
        +Guid Id
        +string Token
        +DateTime Expires
        +bool IsRevoked
        +DateTime? RevokedAt
        +Guid UserId
    }

    %% ---------- Geo (Sprints 1-3) ----------
    class Country {
        +string? Name
        +string? Slug
        +string? PictureUrl
    }
    class City {
        +string? Name
        +int Population
        +bool IsCapital
        +string? Slug
        +Guid CountryId
        +Guid GeoDataId
    }
    class GeoData {
        +decimal Latitude
        +decimal Longitude
        +string? Description
    }
    class Club {
        +string Name
        +string Slug
        +LocalDate? FoundingDate
        +ClubAge ClubAge
        +Guid? CityId
        +Guid? StadiumId
    }
    class ClubAge {
        <<enumeration>>
        U7
        U9
        U11
        U13
        U16
        U19
        U21
        Senior
    }
    class Stadium {
        +string? Name
        +int Capacity
        +DateTime DateOfConstruction
        +string? Slug
        +string? PictureUrl
        +Guid CityId
        +Guid GeoDataId
    }

    %% ---------- Match (Sprints 1-3) ----------
    class Match {
        +Instant Date
        +int FollowersCount
        +int? HomeScore
        +int? AwayScore
        +int? HalfHomeScore
        +int? HalfAwayScore
        +bool IsPostponed
        +string? Slug
        +Guid StatusId
        +Guid StadiumId
        +Guid? HomeSelectionId
        +Guid? AwaySelectionId
        +Guid? RoundId
        +Guid? RefereeId
        +Guid? HomeFormationId
        +Guid? AwayFormationId
    }
    class MatchLineup {
        +Guid MatchId
        +Guid SelectionId
        +Guid PlayerId
        +Guid? PositionId
        +Guid? SubPositionId
        +bool IsStarter
        +int? ShirtNumber
    }
    class Event {
        Guid MatchId
        Guid EventTypeId
        Guid MatchPartId
        Guid SelectionId
        Guid? PlayerId
        Guid? RelatedPlayerId
        int Minute
        int AddedMinute
        string? Note
    }
    class EventType {
        string Code
        string Name
        int SortOrder
    }
    class MatchPart {
        string Code
        string Name
        int SortOrder
    }
    class MatchStatus {
        +string Name
        +string? Slug
        +int SortOrder
    }

    %% ---------- Selection and people (Sprints 1-3) ----------
    class Selection {
        +string Name
        +string Abbreviation
        +string? PictureUrl
        +int FollowersCount
        +string? Slug
        +Guid CountryId
        +Guid? ClubId
        +Guid? HomeStadiumId
    }
    class Person {
        +string FirstName
        +string LastName
        +LocalDate DateOfBirth
        +byte[] Picture
    }
    class Player {
        +decimal Height
        +int ShirtNumber
        +float TransferValue
        +Guid? PositionId
        +Guid? SubPositionId
    }
    class Manager {
        +LocalDate? CareerStart
    }
    class Referee {
        +LocalDate? CareerStart
    }
    class TransferValueHistory {
        +LocalDate? Date
        +decimal? Value
        +Guid PlayerId
    }
    class PlayerSelectionHistory {
        +int? Goals
        +int? MatchPlayed
        +int? Assists
        +int? ShirtNumber
        +Guid PlayerId
        +Guid? SelectionId
    }
    class SelectionManagerHistory {
        +string? Notes
        +int? Wins
        +int? Loses
        +int? Draw
        +Guid ManagerId
        +Guid? SelectionId
    }
    class MandateDate {
        +LocalDate? StartDate
        +LocalDate? EndDate
        +Guid? PlayerSelectionHistoryId
        +Guid? SelectionManagerHistoryId
    }

    %% ---------- Formation (Sprints 1-3) ----------
    class Formation {
        +string Code
        +string? Slug
        +Guid FormationMarkId
    }
    class FormationMark {
        +int Defenders
        +int Midfielders
        +int Attackers
        +string? Slug
    }
    class Position {
        +string Name
        +string? Slug
    }
    class SubPosition {
        +string Name
        +string? Slug
        +Guid PositionId
    }

    %% ---------- Competition (Sprint 4) ----------
    class Competition {
        +string Name
        +string Slug
        +string? ShortName
        +string? Description
        +Guid? CountryId
    }
    class Season {
        +string Name
        +string Slug
        +LocalDate StartDate
        +LocalDate EndDate
        +bool IsCurrent
        +Guid CompetitionId
    }
    class Round {
        +string Name
        +string Slug
        +int Number
        +Guid SeasonId
    }

    class Statistic {
        +Guid MatchId
    }
    class MatchReview {
        +Guid MatchId
        +Guid AuthorId
        +int Rating
        +string Comment
    }
    class ReviewReaction {
        +Guid ReviewId
        +Guid UserId
        +int Value
    }
    %% ---------- Fan features and premium (Sprint 6) ----------
    class Poll {
        +Guid MatchId
        +string Question
        +Instant OpensAt
        +Instant ClosesAt
    }
    class PollOption {
        +Guid PollId
        +string Label
        +int SortOrder
    }
    class PollVote {
        +Guid PollId
        +Guid OptionId
        +Guid UserId
    }
    class UserPreference {
        +Guid UserId
        +string Theme
        +string Language
        +string DateFormat
    }
    class PaymentTransaction {
        +Guid UserId
        +long AmountCents
        +string Currency
        +int Months
        +string StripeSessionId
        +string? StripePaymentIntentId
        +PaymentStatus Status
        +Instant? PaidAt
    }
    class PaymentStatus {
        <<enumeration>>
        Pending
        Paid
        Expired
    }

    class TeamStatistic {
        +Guid StatisticId
        +Guid SelectionId
        +int TotalShots
        +int ShotsOnTarget
        +int TotalRedCards
        +int TotalYellowCards
        +int Corners
        +int BigChances
        +int Possession
    }

    %% ---------- Inheritance ----------
    IdentityUser~Guid~ <|-- ApplicationUser
    IdentityRole~Guid~ <|-- ApplicationRole
    BaseEntity <|-- Country
    BaseEntity <|-- City
    BaseEntity <|-- GeoData
    BaseEntity <|-- Stadium
    BaseEntity <|-- Club
    BaseEntity <|-- Match
    BaseEntity <|-- MatchLineup
    BaseEntity <|-- MatchStatus
    BaseEntity <|-- Event
    BaseEntity <|-- EventType
    BaseEntity <|-- MatchPart
    BaseEntity <|-- Statistic
    BaseEntity <|-- MatchReview
    BaseEntity <|-- ReviewReaction
    BaseEntity <|-- TeamStatistic
    BaseEntity <|-- Selection
    BaseEntity <|-- Person
    BaseEntity <|-- TransferValueHistory
    BaseEntity <|-- PlayerSelectionHistory
    BaseEntity <|-- SelectionManagerHistory
    BaseEntity <|-- MandateDate
    BaseEntity <|-- Poll
    BaseEntity <|-- PollOption
    BaseEntity <|-- PollVote
    BaseEntity <|-- PaymentTransaction
    BaseEntity <|-- Formation
    BaseEntity <|-- FormationMark
    BaseEntity <|-- Position
    BaseEntity <|-- SubPosition
    BaseEntity <|-- Competition
    BaseEntity <|-- Season
    BaseEntity <|-- Round
    Person <|-- Player
    Person <|-- Manager
    Person <|-- Referee

    %% ---------- Associations ----------
    %% <--> = navigable from both classes (navigation property on each side), --> = only the FK side navigates.
    ApplicationUser "1" <--> "0..*" RefreshToken : RefreshTokens / User

    Country "1" <--> "0..*" City : Cities / Country
    City "0..*" --> "1" GeoData : GeoData
    Club "0..*" --> "0..1" City : City
    Club "0..*" --> "0..1" Stadium : Stadium
    Club --> ClubAge : age group
    Stadium "0..*" --> "1" City : City
    Stadium "0..*" --> "1" GeoData : GeoData

    Match "0..*" <--> "1" MatchStatus : Status / Matches
    Match "0..*" --> "1" Stadium : Stadium
    Match "1" <--> "0..*" Statistic : Statistics / Match
    Statistic "1" <--> "0..*" TeamStatistic : TeamStatistics / Statistic
    TeamStatistic "0..*" --> "1" Selection : Selection
    MatchReview "0..*" --> "1" Match : Match
    Event "0..*" --> "1" Match : Match
    Event "0..*" --> "1" EventType : EventType
    Event "0..*" --> "1" MatchPart : MatchPart
    Event "0..*" --> "1" Selection : Selection
    Event "0..*" --> "0..1" Player : Player off / event player
    Event "0..*" --> "0..1" Player : RelatedPlayer on
    MatchReview "0..*" --> "1" ApplicationUser : Author
    MatchReview "1" <--> "0..*" ReviewReaction : Reactions / Review
    ReviewReaction ..> ApplicationUser : UserId FK
    Match "0..*" <--> "0..1" Selection : HomeSelection / HomeMatches
    Match "0..*" <--> "0..1" Selection : AwaySelection / AwayMatches

    Selection "0..*" --> "1" Country : Country
    Selection "0..*" --> "0..1" Club : Club
    Player "0..*" <--> "0..1" Position : Position / Players
    Player "0..*" <--> "0..1" SubPosition : SubPosition / Players
    Position "1" <--> "0..*" SubPosition : SubPositions / Position
    Formation "1" <--> "1" FormationMark : FormationMark / Formation

    TransferValueHistory "0..*" --> "1" Player : Player
    PlayerSelectionHistory "0..*" --> "1" Player : Player
    PlayerSelectionHistory "0..*" <--> "0..1" Selection : Selection / PlayerHistories
    SelectionManagerHistory "0..*" --> "1" Manager : Manager
    SelectionManagerHistory "0..*" <--> "0..1" Selection : Selection / ManagerHistories
    MandateDate "0..*" --> "0..1" PlayerSelectionHistory : PlayerSelectionHistory
    MandateDate "0..*" --> "0..1" SelectionManagerHistory : SelectionManagerHistory

    Poll "0..*" --> "1" Match : Match
    Poll "1" <--> "0..*" PollOption : Options / Poll
    Poll "1" <--> "0..*" PollVote : Votes / Poll
    PollOption "1" <--> "0..*" PollVote : Votes / Option
    PollVote "0..*" --> "1" ApplicationUser : User
    UserPreference "0..1" --> "1" ApplicationUser : User (UserId is the key)
    PaymentTransaction "0..*" --> "1" ApplicationUser : User
    PaymentTransaction --> PaymentStatus : status

    Competition "0..*" --> "0..1" Country : Country
    Competition "1" <--> "0..*" Season : Seasons / Competition
    Season "1" <--> "0..*" Round : Rounds / Season
    Match "0..*" <--> "0..1" Round : Round / Matches
    Match "0..*" --> "0..1" Referee : Referee
    Match "0..*" --> "0..1" Formation : HomeFormation
    Match "0..*" --> "0..1" Formation : AwayFormation
    Match "1" <--> "0..*" MatchLineup : Lineups / Match
    MatchLineup "0..*" --> "1" Selection : Selection
    MatchLineup "0..*" --> "1" Player : Player
    MatchLineup "0..*" --> "0..1" Position : Position
    MatchLineup "0..*" --> "0..1" SubPosition : SubPosition
    Selection "0..*" --> "0..1" Stadium : HomeStadium

    %% ---------- Legend (colour swatches) ----------
    class LegendEarlier["Legend: Sprints 1-5"] {
        <<legend>>
    }
    class LegendSprint6["Legend: new in Sprint 6"] {
        <<legend>>
    }
    class LegendIdentity["Legend: ASP.NET Identity"] {
        <<legend>>
    }
    LegendEarlier .. LegendSprint6
    LegendSprint6 .. LegendIdentity

    %% ---------- Notes ----------
    note for BaseEntity "All domain classes inherit BaseEntity, including PublicId (the external id) and soft delete via DeletedAt. ApplicationUser has its own PublicId. ApplicationRole and RefreshToken do not inherit BaseEntity."
    note for LegendSprint6 "Sprint 6 added match reviews and reactions, live polls with options and votes, user preferences (settings, keyed by UserId) and Stripe payments with ApplicationUser.PremiumUntil. Favorites and notifications (COMP-53) are not in the domain yet."

